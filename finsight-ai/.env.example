# ============================================================
# FinSight AI — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (production auth + portfolio persistence)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend host/port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ChromaDB persistence path
CHROMA_PERSIST_DIR=./chroma_data

# SQLite path (dev mode paper trading)
SQLITE_DB_PATH=./finsight.db

# Scheduler interval (minutes)
SCHEDULER_INTERVAL_MIN=30

# RSS feed cache TTL (seconds)
RSS_CACHE_TTL=900
